---
/**
 * MiniPresentation — an inline slideshow that breaks out of the prose column
 * to the full viewport width. Wrap a run of <MiniSlide> in it. Flick with
 * touch/trackpad (scroll-snap), the prev/next buttons, or ←/→ when focused.
 * Styles live in global.css (.mp*).
 */
interface Props {
  title: string;
  id?: string;
}
const { title, id } = Astro.props;
---

<section class="mp" id={id} aria-roledescription="carousel" aria-label={title}>
  <div class="mp__inner">
    <header class="mp__head">
      <span class="mp__label">Mini presentation — {title}</span>
      <span class="mp__count" aria-live="polite"><span data-mp-current>01</span> — <span data-mp-total>01</span></span>
    </header>
    <div class="mp__track" tabindex="0" data-mp-track>
      <slot />
    </div>
    <footer class="mp__foot">
      <button type="button" class="mp__btn" data-mp-prev aria-label="Previous slide">← prev</button>
      <ol class="mp__dots" data-mp-dots></ol>
      <button type="button" class="mp__btn" data-mp-next aria-label="Next slide">next →</button>
    </footer>
  </div>
</section>

<script>
  const pad = (n: number) => String(n).padStart(2, "0");

  for (const root of document.querySelectorAll<HTMLElement>(".mp")) {
    const track = root.querySelector<HTMLElement>("[data-mp-track]");
    const dots = root.querySelector<HTMLOListElement>("[data-mp-dots]");
    if (!track || !dots) continue;
    const slides = Array.from(track.querySelectorAll<HTMLElement>(":scope > .mp-slide"));
    const current = root.querySelector("[data-mp-current]");
    const total = root.querySelector("[data-mp-total]");
    const prev = root.querySelector<HTMLButtonElement>("[data-mp-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-mp-next]");
    if (total) total.textContent = pad(slides.length);

    // Break out of whatever column we're in: span the viewport, measured, so
    // it works whether or not the page has the side rail.
    const bleed = () => {
      root.style.marginLeft = "0px";
      const left = root.getBoundingClientRect().left;
      root.style.width = `${document.documentElement.clientWidth}px`;
      root.style.marginLeft = `${-left}px`;
    };
    bleed();
    window.addEventListener("resize", bleed);

    const dotButtons = slides.map((_, i) => {
      const li = document.createElement("li");
      const b = document.createElement("button");
      b.type = "button";
      b.className = "mp__dot";
      b.setAttribute("aria-label", `Slide ${i + 1}`);
      b.addEventListener("click", () => go(i));
      li.append(b);
      dots.append(li);
      return b;
    });

    // Narrow screens: slides stack tall, so size the track to the current
    // slide rather than the tallest one.
    const narrow = window.matchMedia("(max-width: 720px)");
    const fit = () => {
      track.style.height = narrow.matches ? `${slides[index].offsetHeight + 2}px` : "";
    };
    narrow.addEventListener("change", fit);
    window.addEventListener("resize", fit);

    let index = 0;
    const go = (i: number) => {
      const target = slides[Math.max(0, Math.min(slides.length - 1, i))];
      track.scrollTo({ left: target.offsetLeft - track.offsetLeft, behavior: "smooth" });
    };
    const sync = () => {
      index = Math.round(track.scrollLeft / track.clientWidth);
      if (current) current.textContent = pad(index + 1);
      dotButtons.forEach((b, i) => b.setAttribute("aria-current", String(i === index)));
      if (prev) prev.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
      fit();
    };
    track.addEventListener("scroll", () => requestAnimationFrame(sync), { passive: true });
    prev?.addEventListener("click", () => go(index - 1));
    next?.addEventListener("click", () => go(index + 1));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") go(index + 1);
      else if (e.key === "ArrowLeft") go(index - 1);
      else return;
      e.preventDefault();
    });
    sync();
  }
</script>
