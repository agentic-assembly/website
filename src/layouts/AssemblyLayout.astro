---
import Container from "../components/Container.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { type Asset, formatSize } from "../lib/assets";
import { partsRecord } from "../lib/date";
import { iconKindFromExt } from "../lib/icons";
import Layout from "./Layout.astro";

interface Reference {
  title: string;
  url: string;
}

interface NextAssembly {
  id: string;
  title: string;
  date: Date;
  href: string;
}

interface Props {
  title: string;
  date: Date;
  location?: string;
  summary?: string;
  references?: Reference[];
  assets?: Asset[];
  aaId: string;
  prevAssembly?: NextAssembly | null;
  nextAssembly?: NextAssembly | null;
}

const {
  title,
  date,
  location,
  summary,
  references = [],
  assets = [],
  aaId,
  prevAssembly,
  nextAssembly,
} = Astro.props;

const eyebrowDateFmt = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "Asia/Tokyo",
});

const formatEyebrowDate = (d: Date) => {
  const p = partsRecord(eyebrowDateFmt, d);
  return `${p.day} ${p.month} ${p.year}`;
};

const teaserDateFmt = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "short",
  timeZone: "Asia/Tokyo",
});
const formatTeaserDate = (d: Date) => teaserDateFmt.format(d).toUpperCase().replace(/\./g, "");
---

<Layout title={`${title} — Agentic Assembly`}>
  <Header />

  <main>
    <Container as="article" class="va-page">
      <div class="va-eyebrow">
        <span class="acc">{aaId}</span>
        <span>{formatEyebrowDate(date)}</span>
        {location && <span>{location}</span>}
      </div>

      <h1 class="va-title">{title}</h1>

      {
        summary && (
          <section class="va-tldr">
            <div class="va-tldr-label">TL;DR</div>
            <p>{summary}</p>
          </section>
        )
      }

      <div class="va-prose">
        <slot />
      </div>

      {
        assets.length > 0 && (
          <section class="va-assets">
            <div class="va-section-label">Files dropped</div>
            {assets.map((asset) => {
              const ext = asset.ext.toLowerCase();
              const isFile = iconKindFromExt(ext) !== "link";
              return (
                <a
                  href={asset.url}
                  class={`va-card${isFile ? " file" : ""}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <div class="va-card-head">
                    <span class="type">
                      {isFile ? "FILE" : "LINK"} — {ext.toUpperCase()}
                    </span>
                    <span>{formatSize(asset.size)}</span>
                  </div>
                  <div class="va-card-title">{asset.name}</div>
                </a>
              );
            })}
          </section>
        )
      }


      {
        (prevAssembly || nextAssembly) && (
          <nav class="va-teasers" aria-label="Adjacent assemblies">
            {prevAssembly && (
              <div class="va-teaser va-teaser--prev">
                <div class="va-teaser-label">Previous assembly</div>
                <a href={prevAssembly.href} class="va-teaser-link">
                  <span>← {prevAssembly.title}</span>
                  <span class="id">
                    {prevAssembly.id} — {formatTeaserDate(prevAssembly.date)}
                  </span>
                </a>
              </div>
            )}
            {nextAssembly && (
              <div class="va-teaser va-teaser--next">
                <div class="va-teaser-label">Next assembly</div>
                <a href={nextAssembly.href} class="va-teaser-link">
                  <span>{nextAssembly.title} →</span>
                  <span class="id">
                    {nextAssembly.id} — {formatTeaserDate(nextAssembly.date)}
                  </span>
                </a>
              </div>
            )}
          </nav>
        )
      }
    </Container>
  </main>

  <Footer />
</Layout>

<script>
  for (const pre of document.querySelectorAll<HTMLPreElement>(".va-prose pre")) {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "va-copy";
    btn.textContent = "copy";
    btn.addEventListener("click", async () => {
      const code = pre.querySelector("code")?.textContent ?? pre.textContent ?? "";
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = "copied";
        btn.classList.add("is-copied");
        setTimeout(() => {
          btn.textContent = "copy";
          btn.classList.remove("is-copied");
        }, 1400);
      } catch {
        btn.textContent = "failed";
        setTimeout(() => (btn.textContent = "copy"), 1400);
      }
    });
    pre.appendChild(btn);
  }
</script>
